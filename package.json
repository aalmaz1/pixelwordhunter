{
  "name": "pixelwordhunter",
  "version": "1.0.0",
  "description": "TOEIC business English trainer with 600 contextual cards, adaptive spaced practice, and typed recall",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js --ignore-pattern 'dist/**'",
    "test": "vitest run",
    "test:full-bank": "python3 -m unittest discover -s tests -p test_build_toeic_full.py",
    "test:watch": "vitest"
  },
  "keywords": [
    "toeic",
    "vocabulary",
    "english",
    "learning",
    "pwa",
    "game"
  ],
  "author": "Khudayberdiev Almaz",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "workbox-build": {
      "glob": "^14.0.4"
    }
  }
}
