rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function userNotDeleted(uid) {
      return !exists(/databases/$(database)/documents/deletedUsers/$(uid));
    }

    function validUserDocument() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'username', 'email', 'xp', 'progress', 'createdAt', 'updatedAt', 'lastSync'
        ])
        && (!d.keys().hasAny(['username']) || (d.username is string && d.username.size() <= 80))
        && (!d.keys().hasAny(['email']) || (d.email is string && d.email.size() <= 254))
        && (!d.keys().hasAny(['xp']) || (d.xp is int && d.xp >= 0 && d.xp <= 1000000000))
        && (!d.keys().hasAny(['progress']) || (d.progress is map && d.progress.size() <= 1000))
        && (!d.keys().hasAny(['updatedAt']) || d.updatedAt is string)
        && (!d.keys().hasAny(['createdAt']) || d.createdAt is string || d.createdAt is timestamp)
        && (!d.keys().hasAny(['lastSync']) || d.lastSync is timestamp);
    }

    function validDeletionMarker() {
      let d = request.resource.data;
      return d.keys().hasOnly(['deletedAt'])
        && d.deletedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && userNotDeleted(uid) && validUserDocument();
      allow delete: if owns(uid);
    }

    // Self-service account deletion creates this tiny tombstone before deleting
    // users/{uid}. It prevents late writes from another still-authenticated tab
    // or device from recreating the deleted progress document.
    match /deletedUsers/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validDeletionMarker();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
